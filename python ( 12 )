N = int ( input("Ingrese la cantidad de estudiantes: "))

Aprobados = 0
Reprobados = 0 
i = 1 

while i <= N:
    nota = float ( input ("Ingrese la  nota del estudinate {i}: "))
    if nota >= 7:
        Aprobados +=1
    else:
        Reprobados +=1
        i+= 1 

    print(f"Aprobados:{Aprobados}")
    print(f"Reprobados:{ Reprobados}")
