import java.util.Scanner;

class SerieArmonica {
    public static void main(String[] args) {
        int N;
        double suma = 0;
        try (Scanner entrada = new Scanner(System.in)) {
            System.out.print("Ingrese valor de N: ");
            N = entrada.nextInt();

            for (int i = 1; i <= N; i++) {
                suma = suma + 1.0 / i;
            }

            System.out.println("Suma de la serie: " + suma);
        }
    }
}
