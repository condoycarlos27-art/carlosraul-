import java.util.Scanner;
class SumaHastaN {
    public static void main(String[] args) {
        int N, suma=0;
        try (Scanner entrada = new Scanner(System.in)) {
            System.out.print("Ingrese valor de N: ");
            N = entrada.nextInt();
            for(int i=1; i<=N; i++){
                suma = suma + i;
            }
            System.out.println("Suma total: " + suma);
        }
    }
}
