INICIO
    LEER numero
    original ← numero
    suma_cubos ← 0
    MIENTRAS numero > 0 HACER
        digito ← numero MOD 10
        suma_cubos ← suma_cubos + digito^3
        numero ← numero DIV 10
    FIN MIENTRAS
    SI suma_cubos = original ENTONCES
        IMPRIMIR "Es número de Armstrong"
    SINO
        IMPRIMIR "NO es número de Armstrong"
    FIN SI
FIN
