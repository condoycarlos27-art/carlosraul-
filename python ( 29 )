n = int(input("Cantidad de calificaciones: "))

suma = 0
mayor = 0
menor = 100
aprobados = 0
reprobados = 0

for i in range(1, n + 1):
    nota = float(input(f"Nota {i}: "))
    suma += nota
    
    if nota > mayor:
        mayor = nota
    if nota < menor:
        menor = nota
    
    if nota >= 7:
        aprobados += 1
    else:
        reprobados += 1

promedio = suma / n

print("\n===== RESUMEN =====")
print(f"Promedio: {promedio:.2f}")
print(f"Nota mayor: {mayor}")
print(f"Nota menor: {menor}")
print(f"Aprobados (≥7): {aprobados}")
print(f"Reprobados: {reprobados}")
