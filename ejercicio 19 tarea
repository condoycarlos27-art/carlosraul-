ALGORITMO DistanciaYPuntoMedio
    DEFINIR x1, y1, x2, y2, distancia, mx, my COMO REAL
    
    ESCRIBIR "Punto 1 (x1, y1):"
    LEER x1, y1
    ESCRIBIR "Punto 2 (x2, y2):"
    LEER x2, y2
    
    distancia = RAIZ((x2 - x1)^2 + (y2 - y1)^2)
    mx = (x1 + x2) / 2
    my = (y1 + y2) / 2
    
    ESCRIBIR "Distancia: ", distancia
    ESCRIBIR "Punto medio: (", mx, ", ", my, ")"
FIN
